# Print server settings. `uwacwy-print-server [env-file]` reads them from env-file
# (default ./.env); existing environment variables win.
# In this repository, copy to packages/server/.env for `npm run dev -w @uwacwy/print-server` and `npm run start:server`.

HOST=127.0.0.1
PORT=8080
# Relative paths resolve from the repo root; holds print.db and queued PDFs.
DATA_DIR=./data
# Printed in QR codes and agent install commands. "Add printer" can enroll printers from their own
# computers only when this is https:// (or localhost).
PUBLIC_URL=http://localhost:8080
# Minutes an "Add printer" setup command (enrollment token) works; default 30.
#ENROLL_TOKEN_TTL_MINUTES=30
SITE_TITLE=Remote Print
# A logo.svg, logo.png, or logo.jpg in dist/browser is shown in the page header; this describes it
# for screen readers. Restart the server after adding or replacing the logo.
#LOGO_ALT=United Way
#CLIENT_BRAND_LOGO=/logo.svg
# Footer: organization in the copyright notice, extra links, and the package name/version line.
#CLIENT_LEGAL_ORG_NAME=United Way of Albany County
#CLIENT_BRAND_LINKS=label=Privacy&url=https://example.com/privacy&label=Terms&url=/terms
#CLIENT_SHOW_ATTRIBUTION=true
# Used for dates printed on QR code pages.
TIME_ZONE=America/Denver
LOG_LEVEL=info
# Only enable behind a reverse proxy (Traefik); otherwise clients can spoof their IP for rate limiting.
TRUST_PROXY=false

# --- socket.io during `ng serve` (the server `dev` script) ------------------
# The SSR server reads this file itself (existing environment variables win), so a
# bare `ng serve` gets the same settings as the `dev` script. Set PRINT_ENV_FILE to use
# another file.
# The Angular dev server cannot hand WebSocket upgrades to server.ts, so under
# `ng serve` socket.io listens on this loopback port (default 4201) and
# proxy.conf.mjs forwards http://localhost:4200/ws to it. Agents use
# PRINT_SERVER_URL=http://localhost:4200. Set to 0 to disable. Ignored in
# production, where `npm run start:server` serves /ws on PORT.
#SOCKET_DEV_PORT=4201

MAX_UPLOAD_MB=20
MAX_DOCUMENTS_PER_JOB=5
MAX_COPIES=5
# Photos are downsampled to this resolution over a 7.5 x 10 in area (150 -> max 1125 x 1500 px).
IMAGE_DPI=150
UPLOADS_PER_MINUTE=10
JOB_TTL_HOURS=24
RETENTION_DAYS=7
# Requests are logged as JSON lines to DATA_DIR/logs/access.log, a symlink to the current
# access-YYYY-MM-DD.log. Files older than this many days are deleted; 0 turns the log off.
# Query credentials (?token=, ?code=, ...) are redacted; /api/healthz is not logged.
#ACCESS_LOG_DAYS=14

# --- Upload access (QR tokens and printer PINs) ------------------------------
# Every upload needs a signed token: either from a QR code an admin generates in
# /manage, or exchanged for a printer's 9-digit PIN. Required; at least 32 characters.
# Generate with: openssl rand -base64 48
# Changing it immediately invalidates every QR code and PIN link already issued.
# Tokens are a compact 42-character code authenticated with an HMAC key derived from this
# secret and ENTRA_CLIENT_ID (below), or "uwacwy-print" when it is unset, so changing the
# client ID invalidates them too.
UPLOAD_TOKEN_SECRET=
# Longest validity window an admin may give a QR code.
#UPLOAD_TOKEN_MAX_DAYS=365
# How long the upload link obtained with a PIN stays valid.
#PIN_TOKEN_TTL_MINUTES=10
# Each client may exchange a PIN for a link once per this many minutes.
#PIN_TOKEN_INTERVAL_MINUTES=10
# Wrong PINs allowed per client and printer within 15 minutes before lockout.
#PIN_MAX_FAILURES=3
# IPv6 clients are rate limited per prefix of this length (32-64); cellular
# carriers usually hand each device a /64 out of a larger shared block.
# Behind a reverse proxy, set TRUST_PROXY so limits apply to the real client IP.
#RATE_LIMIT_IPV6_SUBNET=56

# --- Optional Microsoft Entra ID sign-in for /manage ---------------------------
# Leave unset to disable /manage. Entra requires PUBLIC_URL to be HTTPS, so this
# usually cannot be exercised against plain http://localhost.
#PUBLIC_URL=https://print.example.org
#ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
#ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
#ENTRA_CLIENT_SECRET=
#ENTRA_CLIENT_SECRET_FILE=/run/secrets/entra_client_secret
# For the SPA REST API, accepted audiences default to ENTRA_CLIENT_ID and its
# api:// form. Set this only when the token's aud claim uses another value.
#ENTRA_API_AUDIENCE=api://00000000-0000-0000-0000-000000000000
# The delegated scope required by the admin REST API.
#ENTRA_ADMIN_SCOPE=Printers.Manage
# Optional additional restriction. If unset, the Printers.Manage delegated scope
# is sufficient; if set, a matching role or configured group is also required.
#ENTRA_ADMIN_ROLE=PrintAdmin
# Comma-separated; admins match by email/UPN (case-insensitive) or group object ID.
#ENTRA_ADMIN_EMAILS=you@unitedwayalbanycounty.org
#ENTRA_ADMIN_GROUP_IDS=
# At least 32 characters; generate with: openssl rand -base64 48
#SESSION_SECRET=
#SESSION_HOURS=12
