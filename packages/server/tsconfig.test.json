/* Typechecks the vitest API tests (`*.test.ts`); Angular specs use tsconfig.spec.json. */
{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "noEmit": true
  },
  "include": ["src/**/*.test.ts", "src/**/*.d.ts"],
  "exclude": [],
  /* Lets Rename Symbol and Find References started in shared reach this project. */
  "references": [{ "path": "../shared/tsconfig.json" }]
}
