{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Drops the base mapping so shared cannot import itself.
    "paths": {},
    "composite": true,
    "emitDeclarationOnly": true,
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/tsconfig.tsbuildinfo",
    "module": "preserve",
    "moduleResolution": "bundler"
  },
  "include": ["src"],
  "exclude": ["src/**/*.test.ts"]
}
