/* Typechecks the vitest tests co-located with shared helpers. */
{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Drops the base mapping so shared cannot import itself.
    "paths": {},
    "module": "preserve",
    "moduleResolution": "bundler",
    "noEmit": true
  },
  "include": ["src/**/*.test.ts", "src/**/*.d.ts"],
  /* Lets Rename Symbol and Find References started in shared reach this project. */
  "references": [{ "path": "./tsconfig.json" }]
}
