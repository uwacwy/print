{
  "name": "@uwacwy/print-shared",
  "version": "1.0.0-rc.3",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b && node build.mjs",
    "dev": "tsc -b --watch --preserveWatchOutput",
    "test-api": "vitest run",
    "typecheck": "tsc -b && tsc -p tsconfig.test.json",
    "lint": "eslint .",
    "lint:typed": "eslint -c ../../eslint.typecheck.config.mjs .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "ts-routes": "^2.0.1",
    "zod": "^4.6.7"
  }
}
