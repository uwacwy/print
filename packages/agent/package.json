{
  "name": "@uwacwy/print-agent",
  "version": "1.0.0",
  "description": "United Way Quick Print agent: connects to a Quick Print server and prints its jobs through CUPS or IPP.",
  "keywords": [
    "cups",
    "ipp",
    "print",
    "print-agent",
    "raspberry-pi"
  ],
  "homepage": "https://github.com/uwacwy/print#readme",
  "bugs": {
    "url": "https://github.com/uwacwy/print/issues"
  },
  "license": "MIT",
  "author": "United Way of Albany County",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uwacwy/print.git",
    "directory": "packages/agent"
  },
  "bin": {
    "uwacwy-print-agent": "dist/cli.mjs"
  },
  "files": [
    "dist/cli.mjs",
    "dist/chunks/",
    ".env.example"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -b ../shared && tsc -p tsconfig.json --noEmit && node build.mjs",
    "dev": "tsx --watch src/index.ts run --config .env",
    "test-api": "vitest run",
    "typecheck": "tsc -b ../shared && tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "lint": "eslint .",
    "lint:typed": "eslint -c ../../eslint.typecheck.config.mjs .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepack": "npm run build && node ../../scripts/prepack.mjs dist/cli.mjs",
    "postpack": "node ../../scripts/prepack.mjs --clean"
  },
  "dependencies": {
    "ipp": "^1.1.0"
  },
  "devDependencies": {
    "@inquirer/prompts": "^8.7.5",
    "@stricli/auto-complete": "^1.3.0",
    "@stricli/core": "^1.3.0",
    "@types/node": "^20.19.43",
    "@uwacwy/print-shared": "1.0.0",
    "bonjour-service": "^1.4.4",
    "esbuild": "^0.25.0",
    "locate-path": "^8.0.0",
    "rxjs": "~7.8.2",
    "socket.io-client": "^4.8.4",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3"
  },
  "engines": {
    "node": ">=20.17"
  }
}
