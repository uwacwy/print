{
  "name": "@uwacwy/print-agent",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "node": "./dist/print-agent.mjs"
    }
  },
  "scripts": {
    "start": "tsx --watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc -p tsconfig.json --noEmit && esbuild src/index.ts --bundle --platform=node --target=node20 --format=cjs --external:ipp --external:bufferutil --external:utf-8-validate --outfile=dist/print-agent.cjs",
    "package": "npm run build && tar -czf dist/uwacwy-print-agent.tar.gz --transform 's,^,uwacwy-print-agent/,' -C dist print-agent.cjs -C .. install.sh uwacwy-print-agent.service -C ../.. node_modules/ipp"
  },
  "dependencies": {
    "@uwacwy/print-shared": "1.0.0",
    "ipp": "^1.1.0",
    "rxjs": "~7.8.2",
    "socket.io-client": "^4.8.4"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "esbuild": "^0.25.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3"
  }
}
