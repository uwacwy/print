# Print agent settings, as written by `uwacwy-print-agent install` to uwacwy-print-agent.env in
# ~/.config (or /etc as root). `uwacwy-print-agent run` searches ~/.config, /usr/local/etc, and /etc,
# or reads `--config <file>`; environment variables win over the file.
# For local testing, copy to packages/agent/.env and run `npm run dev -w @uwacwy/print-agent` from the repo root.

# Plain http:// is accepted only on localhost, or with `run --insecure`.
PRINT_SERVER_URL=http://localhost:8080
# Shown once when the printer is added on /manage, or by `npm run admin -- printer:add …`.
PRINT_AGENT_TOKEN=
# cups://Queue_Name uses local CUPS; ipp:// or ipps:// submits to a network printer.
# `uwacwy-print-agent list-queues` lists both.
# Optional query settings:
#   maxBytes=104857600            reject larger downloads (and PCLm output)
#   mimeTypes=application/pdf     comma-separated content types to accept
#   timeout=120000                per-command timeout in ms (lp, IPP request)
#   dpi=150                       CUPS only: downsample images to this before lp (0 = off)
#   quality=draft|normal|high     IPP only: print quality
#   format=application/PCLm       IPP only: skip format negotiation
#   option_<name>=<value>         CUPS only: passed to lp as -o <name>=<value>
#                                 (no extra -o options are sent unless configured)
# The CUPS driver reports a job printed only once CUPS completes it (waiting up to 10 minutes),
# When CUPS stops the queue after a printer error, it re-enables the queue up to 3 times
# (after 15s, 30s and 60s) so CUPS retries the job, then cancels it and reports it failed.
# e.g. cups://Queue_Name?option_print-quality=3&option_sides=two-sided-long-edge
#   or ipp://printer.local/ipp/print?format=application/pdf&timeout=180000
PRINTER_URI=ipp://printer.local:631/ipp/print
