# Print agent settings. Pass the file to `uwacwy-print-agent <env-file>`, or set the variables
# in the environment. On a Pi, install.sh writes them to /etc/uwacwy-print-agent.env.
# For local testing, copy to packages/agent/.env and run `npm run dev:agent` from the repo root.

# Plain http:// is accepted here for local testing; install.sh requires https://.
PRINT_SERVER_URL=http://localhost:8080
# Printed once by `npm run admin -- printer:add <slug> "<name>" <destination>` or the /manage page.
PRINT_AGENT_TOKEN=
# cups://Queue_Name uses local CUPS; ipp:// or ipps:// submits to a network printer.
# Optional query settings:
#   maxBytes=104857600            reject larger downloads (and PCLm output)
#   mimeTypes=application/pdf     comma-separated content types to accept
#   timeout=120000                per-job print timeout in ms
#   quality=draft|normal|high     IPP only: print quality
#   format=application/PCLm       IPP only: skip format negotiation
#   option_<name>=<value>         CUPS only: passed to lp as -o <name>=<value>
#                                 (no extra -o options are sent unless configured)
# e.g. cups://Queue_Name?option_print-quality=3&option_sides=two-sided-long-edge
#   or ipp://printer.local/ipp/print?format=application/pdf&timeout=180000
PRINTER_URI=ipp://printer.local:631/ipp/print
# Legacy size limit in MB, used only when PRINTER_URI has no maxBytes.
# MAX_JOB_MB=100
