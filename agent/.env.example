# Print agent settings. On a Pi, install.sh writes these to /etc/omega-print-agent.env.
# For local testing, copy to agent/.env and run `npm run dev:agent` from the repo root.

# Plain http:// is accepted here for local testing; install.sh requires https://.
PRINT_SERVER_URL=http://localhost:8080
# Printed once by `npm run admin -- printer:add <slug> "<name>" <destination>` or the /manage page.
PRINT_AGENT_TOKEN=
# cups://Queue_Name uses local CUPS; ipp:// or ipps:// submits to a network printer.
PRINTER_URI=ipp://printer.local:631/ipp/print
# Reject downloaded jobs larger than this.
MAX_JOB_MB=100
