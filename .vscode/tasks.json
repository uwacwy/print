{
  // For more information, visit: https://go.microsoft.com/fwlink/?LinkId=733558
  "version": "2.0.0",
  "tasks": [
    {
      "label": "server: dev",
      "type": "npm",
      "script": "dev",
      "path": "packages/server",
      "isBackground": true,
      "problemMatcher": {
        "owner": "typescript",
        "pattern": "$tsc",
        "background": {
          "activeOnStart": true,
          "beginsPattern": {
            "regexp": "Changes detected"
          },
          "endsPattern": {
            "regexp": "bundle generation (complete|failed)"
          }
        }
      }
    },
    {
      "label": "agent: dev",
      "type": "npm",
      "script": "dev",
      "path": "packages/agent",
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "server: test-ng",
      "type": "npm",
      "script": "test-ng",
      "path": "packages/server",
      "problemMatcher": "$tsc"
    },
    {
      "label": "test-api",
      "type": "npm",
      "script": "test-api",
      "problemMatcher": []
    }
  ]
}
