{
  "name": "@uwacwy/print",
  "version": "1.0.0-rc.3",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uwacwy/print.git"
  },
  "workspaces": [
    "packages/shared",
    "packages/agent",
    "packages/server"
  ],
  "type": "module",
  "scripts": {
    "ng": "ng",
    "build": "npm run build --workspaces --if-present",
    "test-ng": "npm run test-ng --workspaces --if-present",
    "test-api": "npm run test-api --workspaces --if-present",
    "test": "npm run test-ng && npm run test-api",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "lint:typed": "npm run lint:typed --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dupes": "jscpd",
    "start:server": "node packages/server/dist/server/server.mjs",
    "dev:server": "npm run dev --workspace packages/server",
    "version:set": "node scripts/set-version.mjs",
    "version:check": "node scripts/check-version.mjs",
    "compose:check": "for f in examples/compose.*.yml; do UPLOAD_TOKEN_SECRET=x PRINT_SERVER_URL=x PRINT_AGENT_TOKEN_IPP=x PRINT_AGENT_TOKEN_CUPS=x docker compose -f \"$f\" config -q || exit 1; done && docker compose -f compose.yml config -q"
  },
  "devDependencies": {
    "@angular/build": "^22.1.3",
    "@angular/cli": "^22.1.3",
    "@angular/compiler-cli": "^22.1.0",
    "@angular/localize": "22.2.3",
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/busboy": "^1.5.5",
    "@types/express": "^5.0.1",
    "@types/heic-convert": "^2.1.1",
    "@types/node": "^24.0.0",
    "@types/passport": "^1.0.17",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-strategy": "^0.2.38",
    "@types/qrcode": "^1.5.6",
    "@types/ws": "^8.18.2",
    "angular-eslint": "^22.6.0",
    "concurrently": "^10.0.6",
    "env-cmd": "^11.0.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^18.5.0",
    "eslint-plugin-perfectionist": "^5.13.0",
    "globals": "^17.14.0",
    "jscpd": "^5.4.3",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.72.2",
    "vitest": "^4.0.8"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "npm@11.12.1"
}
