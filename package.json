{
  "name": "@uwacwy/print",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "shared",
    "server",
    "agent"
  ],
  "type": "module",
  "scripts": {
    "ng": "ng",
    "start": "tsc -b shared && ng serve print-server",
    "build": "tsc -b shared && ng build print-server",
    "watch": "ng build print-server --watch --configuration development",
    "test": "ng test print-server --watch=false && npm run test:api",
    "test:spa": "ng test print-server --watch=false",
    "test:api": "vitest run server/src/**/*.test.ts agent/src/**/*.test.ts packages/server/src/*.test.ts packages/server/src/api/ packages/server/src/realtime/*.test.ts packages/server/src/lib/*/*.test.ts packages/server/src/app/auth/msal.config.spec.ts",
    "build:api": "tsc -b shared server && npm run build -w agent",
    "typecheck:api": "tsc -b shared server && tsc -p agent --noEmit && npm run typecheck:api:tests",
    "typecheck:api:tests": "tsc -b shared && tsc -p server/tsconfig.test.json && tsc -p agent/tsconfig.test.json",
    "dev:server": "npm run build:api && node --env-file-if-exists=server/.env server/dist/server/src/index.js",
    "dev:agent": "npm run build -w agent && node --env-file-if-exists=agent/.env agent/dist/print-agent.cjs",
    "admin": "node --env-file-if-exists=server/.env server/dist/server/src/cli.js",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "serve:ssr:print-server": "node dist/print-server/server/server.mjs"
  },
  "dependencies": {
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/platform-server": "^22.1.0",
    "@angular/router": "^22.1.0",
    "@angular/ssr": "^22.1.3",
    "@azure/msal-angular": "^6.2.5",
    "@azure/msal-browser": "^5.27.0",
    "@popperjs/core": "^2.11.8",
    "better-sqlite3": "^12.4.1",
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.2",
    "busboy": "^1.6.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.1",
    "file-type": "^21.0.0",
    "heic-convert": "^2.1.0",
    "jose": "^6.2.13",
    "jwks-rsa": "^4.1.0",
    "mysql2": "^3.15.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-strategy": "^1.0.0",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "rxjs": "~7.8.0",
    "sharp": "^0.34.4",
    "socket.io": "^4.8.4",
    "tslib": "^2.3.0",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@angular/build": "^22.1.3",
    "@angular/cli": "^22.1.3",
    "@angular/compiler-cli": "^22.1.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/busboy": "^1.5.5",
    "@types/express": "^5.0.1",
    "@types/heic-convert": "^2.1.1",
    "@types/node": "^24.0.0",
    "@types/passport": "^1.0.17",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-strategy": "^0.2.38",
    "@types/qrcode": "^1.5.6",
    "@types/ws": "^8.18.2",
    "concurrently": "^10.0.6",
    "env-cmd": "^11.0.0",
    "jsdom": "^28.0.0",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "prettier": "^3.8.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "npm@11.12.1"
}
