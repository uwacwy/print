{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm"
  },
  "newProjectRoot": "projects",
  "projects": {
    "print-server": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "packages/server",
      "sourceRoot": "packages/server/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "packages/server/src/main.ts",
            "tsConfig": "packages/server/tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "packages/server/public"
              }
            ],
            "styles": [
              "packages/server/src/styles.scss",
              "node_modules/bootstrap-icons/font/bootstrap-icons.min.css",
              "node_modules/bootstrap/dist/css/bootstrap.css"
            ],
            "scripts": [
              "node_modules/@popperjs/core/dist/umd/popper.js",
              "node_modules/bootstrap/dist/js/bootstrap.js"
            ],
            "server": "packages/server/src/main.server.ts",
            "outputMode": "server",
            "externalDependencies": [
              "better-sqlite3",
              "heic-decode",
              "libheif-js",
              "ws",
              "bufferutil",
              "utf-8-validate"
            ],
            "security": {
              "allowedHosts": [
                "localhost",
                "127.0.0.1",
                "10.1.10.138"
              ]
            },
            "ssr": {
              "entry": "packages/server/src/server.ts"
            }
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1.5MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all",
              "styles": [
                "packages/server/src/styles.scss",
                "node_modules/bootstrap-icons/font/bootstrap-icons.min.css",
                "node_modules/bootstrap/dist/css/bootstrap.min.css"
              ],
              "scripts": [
                "node_modules/@popperjs/core/dist/umd/popper.min.js",
                "node_modules/bootstrap/dist/js/bootstrap.min.js"
              ]
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "fileReplacements": [
                {
                  "replace": "packages/server/src/environments/environment.ts",
                  "with": "packages/server/src/environments/environment.development.ts"
                }
              ]
            }
          },
          "defaultConfiguration": "development"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "port": 4200,
            "proxyConfig": "proxy.conf.mjs",
            "allowedHosts": ["*"]
          },
          "configurations": {
            "production": {
              "buildTarget": "print-server:build:production"
            },
            "development": {
              "buildTarget": "print-server:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "include": ["**/*.spec.ts"]
          }
        }
      }
    }
  }
}
